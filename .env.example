# Optional. The public address of the site, used for link previews (Open Graph).
# In GitHub Actions this comes from the SITE_URL repository variable.
NEXT_PUBLIC_SITE_URL=https://your-distribution.cloudfront.net

# ---- chat bot, local development only (see docs/CHATBOT.md) ----
# Copy this file to .env and paste your key. .env is git-ignored. It is read only by
# `npm run chat:dev` (the local chat API), never by the website, so it never reaches visitors.
# Never rename this to NEXT_PUBLIC_...: anything with that prefix is published in the site's JavaScript.
ANTHROPIC_API_KEY=sk-ant-...

# Put this line in .env.local so `npm run dev` talks to the local chat API.
# NEXT_PUBLIC_CHAT_API_URL=http://localhost:8787
